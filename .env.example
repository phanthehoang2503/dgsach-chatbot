# postgresql
DB_HOST=localhost
DB_PORT=5434
DB_NAME=vectordb
DB_SUPERUSER_PASS=change_me
DB_USER=bookstreet_app
DB_PASS=change_me
INGEST_DB_USER=bookstreet_ingest
INGEST_DB_PASS=change_me

# Optional: Dedicated test database (must contain 'test' or set ALLOW_DESTRUCTIVE_TESTS=true)
# TEST_DB_NAME=vectordb_test
# ALLOW_DESTRUCTIVE_TESTS=false
MAX_DISTANCE=0.5

# AI Provider
OLLAMA_HOST=http://127.0.0.1:11434
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
VECTOR_DIM=1024
LLM_MODEL=qwen3:4b
LLM_TEMPERATURE=0.2



GEMINI_API_KEY=your_gemini_api_key_here

# Admin API authentication (required for /api/v1/documents endpoints)
ADMIN_API_KEY=your_admin_api_key_here

# Timeouts & Rate Limiting
OLLAMA_TIMEOUT=60
GEMINI_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=10000
CHAT_RATE_LIMIT=10/minute
LLM_MAX_CONCURRENCY=4
